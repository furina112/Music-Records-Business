<?php
require 'authentication.php';      // login guard (also gives us $uid)
require 'music_dbconfig.php';

// ADD a record
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $pdo->prepare("INSERT INTO records (artist_id, title, price, release_year, added_by, updated_by) VALUES (?,?,?,?,?,?)")
        ->execute([$_POST['artist_id'], $_POST['title'], $_POST['price'], $_POST['release_year'], $uid, $uid]);
    header("Location: records_index.php?artist_id=" . $_POST['artist_id']);
    exit;
}

$artists = $pdo->query("SELECT * FROM artists")->fetchAll(PDO::FETCH_ASSOC);
$filter  = $_GET['artist_id'] ?? null;

$sql = "SELECT r.*, a.artist_name,
               CONCAT(u1.first_name,' ',u1.last_name) AS added_by_name,
               CONCAT(u2.first_name,' ',u2.last_name) AS updated_by_name
        FROM records r
        JOIN artists a ON r.artist_id = a.artist_id
        LEFT JOIN users u1 ON r.added_by   = u1.user_id
        LEFT JOIN users u2 ON r.updated_by = u2.user_id";
$stmt = $filter ? $pdo->prepare($sql . " WHERE r.artist_id=?") : $pdo->prepare($sql);
$stmt->execute($filter ? [$filter] : []);
$records = $stmt->fetchAll(PDO::FETCH_ASSOC);
