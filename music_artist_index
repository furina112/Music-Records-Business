<?php
require 'authentication.php';
require 'music_dbconfig.php';

if (empty($_SESSION['csrf'])) {
    $_SESSION['csrf'] = bin2hex(random_bytes(32));
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!hash_equals($_SESSION['csrf'], $_POST['csrf'] ?? '')) {
        http_response_code(403);
        exit('Invalid request.');
    }

    $name  = trim($_POST['artist_name'] ?? '');
    $genre = trim($_POST['genre'] ?? '');

    if ($name !== '') {
        $pdo->prepare(
            "INSERT INTO artists (artist_name, genre, added_by, updated_by) VALUES (?,?,?,?)"
        )->execute([$name, $genre ?: null, $uid, $uid]);
    }

    header("Location: music_artist_index.php");
    exit;
}

$artists = $pdo->query("
  SELECT a.*,
         CONCAT(u1.first_name,' ',u1.last_name) AS added_by_name,
         CONCAT(u2.first_name,' ',u2.last_name) AS updated_by_name
  FROM artists a
  LEFT JOIN users u1 ON a.added_by   = u1.user_id
  LEFT JOIN users u2 ON a.updated_by = u2.user_id
  ORDER BY a.artist_name
")->fetchAll(PDO::FETCH_ASSOC);
?>
