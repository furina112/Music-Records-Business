<?php
session_start();
require 'music_dbconfig.php';
$error = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $first        = trim($_POST['first_name']);
    $last         = trim($_POST['last_name']);
    $username     = trim($_POST['username']);
    $age          = (int)trim($_POST['age']);
    $phone_number = trim($_POST['phone_number']);
    $email        = trim($_POST['email']);
    $password     = $_POST['password'];

    if ($first === '' || $last === '' || $username === '' || $email === '') {
        $error = 'Please fill in all required fields!';
    } elseif (strlen($password) < 8) {
        $error = 'Password must be at least 8 characters!';
    } else {
        $c = $pdo->prepare("SELECT user_id FROM users WHERE username=? OR email=?");
        $c->execute([$username, $email]);

        if ($c->fetch()) {
            $error = 'That username or email is already registered!';
        } else {
            $pdo->prepare("INSERT INTO users (first_name, last_name, username, age, phone_number, email, password, date_created)
                           VALUES (?,?,?,?,?,?,?,NOW())")
                ->execute([$first, $last, $username, $age, $phone_number, $email, password_hash($password, PASSWORD_DEFAULT)]);
            header("Location: login.php?registered=1");
            exit;
        }
    }
}
